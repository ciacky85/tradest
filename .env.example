# ============================================
# AI Trading Bot - Environment Variables
# Copia questo file in .env e compila i valori
# ============================================

# --- Applicazione ---
APP_NAME=AI-Trading-Bot
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=DEBUG

# --- AI Provider (Omniroute / Antigravity o Google AI Studio) ---
AI_PROVIDER=omniroute
AI_BASE_URL=http://192.168.1.212:9292/v1
AI_API_KEY=sk-92fbd7ff0bd42a7d-69ee29-81742676
GEMINI_MODEL=carlo-gemini
GEMINI_API_KEY=
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.2

# --- Interactive Brokers ---
IBKR_HOST=192.168.1.212
IBKR_PORT=4004
IBKR_CLIENT_ID=500
IBKR_ACCOUNT_ID=your_account_id_here
IBKR_USERNAME=lhungq693
IBKR_PASSWORD=secretpaper
IBKR_TIMEOUT=30

# --- Database ---
DATABASE_URL=sqlite:///data/trading.db
DATABASE_ECHO=false

# --- Notifiche (tradeBotNotify) ---
NOTIFY_WEBHOOK_URL=http://192.168.1.212:9008/notify
NOTIFY_ENABLED=true
NOTIFY_TIMEOUT=10

# --- Trading Parameters ---
TRADING_ENABLED=false
TRADING_MODE=paper
MAX_DAILY_LOSS=500.0
EMERGENCY_STOP_LOSS=1000.0
AI_MIN_CONFIDENCE=0.70

# --- Scheduling ---
ANALYSIS_INTERVAL_SECONDS=30
PORTFOLIO_SYNC_INTERVAL_SECONDS=60

# --- Timezone ---
TIMEZONE=Europe/Rome
