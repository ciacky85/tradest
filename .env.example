# ============================================
# AI Trading Bot - Environment Variables
# Copia questo file in .env e compila i valori
# ============================================

# --- Applicazione ---
APP_NAME=AI-Trading-Bot
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=DEBUG

# --- Google Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.3

# --- Interactive Brokers ---
IBKR_HOST=172.24.0.2
IBKR_PORT=4004
IBKR_CLIENT_ID=500
IBKR_ACCOUNT_ID=your_account_id_here
IBKR_USERNAME=nautilususer
IBKR_PASSWORD=your_ibkr_password_here
IBKR_TIMEOUT=30

# --- Database ---
DATABASE_URL=sqlite:///data/trading.db
DATABASE_ECHO=false

# --- Notifiche (tradeBotNotify) ---
NOTIFY_WEBHOOK_URL=http://192.168.1.212:9008/notify
NOTIFY_ENABLED=true
NOTIFY_TIMEOUT=10

# --- Trading Parameters ---
TRADING_ENABLED=false
TRADING_MODE=paper
MAX_DAILY_LOSS=500.0
EMERGENCY_STOP_LOSS=1000.0
AI_MIN_CONFIDENCE=0.70

# --- Scheduling ---
ANALYSIS_INTERVAL_SECONDS=30
PORTFOLIO_SYNC_INTERVAL_SECONDS=60

# --- Timezone ---
TIMEZONE=Europe/Rome
